# 本檔只供本機 Gateway 模式與註冊斜線指令使用。
# Cloudflare Worker 的執行密鑰請在 Cloudflare 後台設定，不要提交到 GitHub。

# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# 建議測試期填入伺服器ID；留空會註冊為全域指令。
DISCORD_GUILD_ID=

# 選填：兩者都留空時使用記憶體存檔。
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Gateway／Cloud Run 模式才會使用 PORT；本機不需要設定。
# PORT=8080
